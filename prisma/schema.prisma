generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Album {
  id          String       @id @db.Uuid
  name        String       @unique
  description String       @default("")
  createdAt   DateTime     @default(now()) @map("created_at")
  mediaLinks  MediaAlbum[]

  @@map("albums")
}

model Media {
  id              String       @id
  storageUrl      String       @map("storage_url")
  type            MediaType    @map("media_type")
  caption         String       @default("")
  description     String       @default("")
  visibility      String       @default("public")
  contentHash     String?      @map("content_hash")
  capturedAt      DateTime?    @map("captured_at")
  durationSeconds Int?         @map("duration_seconds")
  fileSizeBytes   BigInt?      @map("file_size_bytes")
  createdAt       DateTime     @default(now()) @map("created_at")
  albumLinks      MediaAlbum[]
  storage         MediaStorage?

  @@map("media")
}

model MediaAlbum {
  mediaId String @map("media_id")
  albumId String @map("album_id") @db.Uuid
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([mediaId, albumId])
  @@map("media_albums")
}

enum MediaType {
  PHOTO
  VIDEO
}

// Runtime schema and backfill are managed by ensureDatabase in src/lib/database.ts.
model MediaStorage {
  mediaId    String  @id @map("media_id")
  provider   String
  objectKey  String  @map("object_key")
  playbackId String? @map("playback_id")
  access     String
  media      Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("media_storage")
}
