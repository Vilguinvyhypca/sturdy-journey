# GitHub OAuth app credentials (keep the real values in .env.local only)
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=
# If your Vercel database integration created this prefixed name instead, the app accepts it too.
DATABASE_URL_DATABASE_URL=
# Vercel creates these for an OIDC-connected private Blob store.
PRIVATE_BLOB_STORE_ID=
PRIVATE_BLOB_WEBHOOK_PUBLIC_KEY=
# Optional fallback for local development outside Vercel.
PRIVATE_BLOB_READ_WRITE_TOKEN=
