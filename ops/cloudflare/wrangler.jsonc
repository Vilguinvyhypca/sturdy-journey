{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mediaspace-fallback",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "vars": { "SITE_HOST": "hymecymeyseh.fun" },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/offline-video.mp4"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "env": {
    "production": {
      "name": "mediaspace-fallback",
      "workers_dev": false,
      "vars": { "SITE_HOST": "hymecymeyseh.fun" },
      "routes": [{ "pattern": "hymecymeyseh.fun/*", "zone_name": "hymecymeyseh.fun" }]
    }
  }
}
