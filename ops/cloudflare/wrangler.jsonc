{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mediaspace-fallback",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "vars": { "SITE_HOST": "hymecymeyseh.fun" },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/offline-video.mp4"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "env": {
    "production": {
      "name": "mediaspace-fallback",
      "account_id": "9afebf2e437a76d70fa9a90d9ca6a9d1",
      "workers_dev": false,
      "vars": { "SITE_HOST": "hymecymeyseh.fun" },
      "routes": [{ "pattern": "hymecymeyseh.fun/*", "zone_id": "d45d1b3edd1a8a0e25177191d5e849dd" }]
    }
  }
}
